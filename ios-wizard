    tools = {
        'gadget': ('gadget_frida', 'Frida gadget injection helpers'),
        'interpose': ('dyld_interpose', 'Generate dyld interpose tracing'),
        'xpc': ('xpc_enum', 'Enumerate XPC services'),
        'launchd': ('launchd_inspect', 'Inspect launchd jobs'),
        'jailbreak': ('jailbreak_check', 'Jailbreak/compromise assessment'),
    }
    if not args or args[0] not in tools:
        print("Usage: ./ios-wizard dynamic <tool> <args...>")
        print("Tools:")
        for name, (script, desc) in tools.items():
            print(f"  {name:15} {desc}")
        return 1
    name = args[0]
    return run_script(DYNAMIC_DIR, tools[name][0], args[1:])


def cmd_pentest(args: list):
    tools = {
        'diff': ('ipa_diff', 'Risk-weighted IPA delta'),
        'probes': ('probe_plan', 'Generate attack surface probes'),
        'baseline': ('device_baseline', 'Device baseline & drift'),
        'report': ('report_gen', 'Unified report generator'),
    }
    if not args or args[0] not in tools:
        print("Usage: ./ios-wizard pentest <tool> <args...>")
        print("Tools:")
        for name, (script, desc) in tools.items():
            print(f"  {name:15} {desc}")
        return 1
    name = args[0]
    return run_script(PENTEST_DIR, tools[name][0], args[1:])


def cmd_test(args: list):
    test_file = SKILL_ROOT / 'test_fixtures.py'
    if not test_file.exists():
        print("Error: test_fixtures.py not found")
        return 1
    return subprocess.call([sys.executable, str(test_file)])


def print_help():
    print("""ios-wizard — iOS Security Wizard unified CLI

Usage:
  ./ios-wizard triage <target.ipa|App.app> [-o report_dir]
      Full static assessment: extract, scan, audit, report.

  ./ios-wizard static <tool> <args...>
      macho | ipa | entitlements | objc | dyld | hardened | crypto

  ./ios-wizard dynamic <tool> <args...>
      gadget | interpose | xpc | launchd | jailbreak

  ./ios-wizard pentest <tool> <args...>
      diff | probes | baseline | report

  ./ios-wizard test
      Run the component test suite.

Docs: README.md (humans), AGENT-GUIDE.md (AI), INDEX.md (corpus map)
""")


def main():
    if len(sys.argv) < 2:
        print_help()
        return 0

    cmd = sys.argv[1]
    args = sys.argv[2:]

    if cmd == 'triage':
        return cmd_triage(args)
    elif cmd == 'static':
        return cmd_static(args)
    elif cmd == 'dynamic':
        return cmd_dynamic(args)
    elif cmd == 'pentest':
        return cmd_pentest(args)
    elif cmd == 'test':
        return cmd_test(args)
    elif cmd in ('help', '--help', '-h'):
        print_help()
        return 0
    else:
        print(f"Unknown command: {cmd}")
        print_help()
        return 1


if __name__ == '__main__':
    sys.exit(main())
